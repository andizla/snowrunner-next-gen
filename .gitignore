# build outputs; the release zip goes to GitHub Releases
out/*
!out/docs/
# the DLL's build output (out/* above only covers the root's out)
dll/out/
# the guide's sources are tracked in out/docs; make_guide.js builds these two from them (the released PDF is docs/SnowRunner_Next_Gen_Guide.pdf)
out/docs/guide.html
out/docs/SnowRunner_Next_Gen_Guide.pdf
out/docs/guide_ru.html
out/docs/SnowRunner_Next_Gen_Guide_RU.pdf
# the translator's working copies (make_guide.js --pack)
out/docs/ru/**/*.en
out/docs/ru/**/*.old
*.exe
*.dll
# the compiled shaders: engine\tools\build_shaders.js makes them from the .hlsl sources
*.cso
*.shader

# working notes, local tools and this machine's dev settings: local only
HANDOFF.md
PACKAGE_NOTES.md
PLAN.md
/tools/
/dev.json
.claude/
